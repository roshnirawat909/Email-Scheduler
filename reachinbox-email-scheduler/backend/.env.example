

NODE_ENV=development

API_PORT=4000

FRONTEND_URL=http://localhost:5173

DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/reachinbox?schema=public"

REDIS_URL=redis://localhost:6379

SESSION_SECRET=

## Google OAuth Configuration

GOOGLE_CLIENT_ID=your-google-oauth-client-id

GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

MAX_CAMPAIGN_RECIPIENTS=10000

## Queue configuration

QUEUE_NAME=reachinbox-email-deliveries

# Worker configuration

WORKER_CONCURRENCY=5

## Outbox configuration

OUTBOX_POLL_INTERVAL_MS=1000

OUTBOX_BATCH_SIZE=100

OUTBOX_MAX_ATTEMPTS=10

OUTBOX_RETRY_BASE_MS=1000

OUTBOX_RETRY_MAX_MS=60000

OUTBOX_STALE_AFTER_MS=60000

## Email sending configuration

EMAIL_RATE_LIMIT_SCOPE=sender

EMAIL_MAX_PER_HOUR=100

EMAIL_MIN_DELAY_MS=1000

EMAIL_JOB_ATTEMPTS=5

EMAIL_JOB_BACKOFF_MS=1000

WORKER_LOCK_DURATION_MS=60000

# SMTP Configuration


SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=

SMTP_PASS=

SMTP_TIMEOUT_MS=30000


## Slack OAuth

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/api/slack/callback
SLACK_NOTIFICATION_CHANNEL_ID=

## Elasticsearch

ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# 32-byte hex key for encrypting OAuth tokens
TOKEN_ENCRYPTION_KEY=


